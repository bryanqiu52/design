{
  // ESA Pages 构建配置：push 到 GitHub 后自动执行 buildCommand 再部署
  // 产物目录 = 仓库根目录（网站文件直接放在根，case/ 与 blog/ 由构建生成）
  "name": "xifofly-site",
  "buildCommand": "node build-static.js",
  "assets": {
    "directory": "./",
    // 404Page：未命中的路径返回根目录的 404.html，并带真实 404 状态码
    // 注意：ESA 只接受字符串枚举，写成对象会导致创建版本时报
    // d.toLowerCase is not a function
    "notFoundStrategy": "404Page"
  }
}
